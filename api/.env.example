APP_NAME="Realtime Notifications API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=realtime
DB_USERNAME=realtime
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The queued BroadcastReservationEvent job runs on redis. A worker must be running:
#   php artisan queue:work
QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Keep pub/sub channel names literal, no key prefixing.
REDIS_PREFIX=

# Shared HMAC secret for the short lived WebSocket token.
# The Node ws/ server must be given the SAME value as WS_TOKEN_SECRET.
WS_TOKEN_SECRET=change-me-to-a-long-random-string
WS_TOKEN_TTL=60

MAIL_MAILER=log
